# StormTrace AI - Environment Configuration Template
# Copy this file to .env and fill in your API keys

# ── Frontend Public Tokens (exposed to Vite/React via VITE_ prefix) ──
VITE_OWM_KEY=your_openweathermap_api_key_here
VITE_HF_TOKEN=your_huggingface_token_here
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# ── Backend Secret Keys (never exposed to frontend) ──
OWM_KEY=your_openweathermap_api_key_here
MAPBOX_TOKEN=your_mapbox_public_token_here
HF_TOKEN=your_huggingface_token_here

# ── Server Config ──
PORT=8000
